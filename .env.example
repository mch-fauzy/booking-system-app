NODE_ENV=development

# Neon Postgres (free tier is enough): https://console.neon.tech -> New project -> Connection details
# Pooled URL (host contains "-pooler") - used by the app, the seed script and integration tests
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Unpooled URL (same host without "-pooler") - used by migrations (drizzle-kit) only
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
