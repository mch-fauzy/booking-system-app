  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "db:generate": "node scripts/db-generate.mjs",
    "db:generate:custom": "node scripts/db-generate.mjs --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "knip": "knip",
    "check:exports": "node .claude/local-checks/no-internal-exports.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
